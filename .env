# ============================================================================
#  NotaMínima — Variables de entorno
# ============================================================================
# Copia este archivo como `.env` en la raíz del proyecto y rellena los valores.
#
#   cp .env.example .env
#
# ¿Dónde consigo estos datos?
#   1. Entra a https://supabase.com y crea una cuenta gratuita.
#   2. Crea un proyecto nuevo.
#   3. Ve a  Project Settings → API.
#   4. Copia "Project URL" y "anon public" key.
#
# IMPORTANTE: la `anon key` es pública por diseño (se usa en el navegador).
# La seguridad real se aplica con Row Level Security (RLS) en Supabase.
# Nunca publiques la `service_role` key.
# ----------------------------------------------------------------------------

VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-public-key

# Opcional: nombre mostrado en la aplicación
VITE_APP_NAME=NotaMínima
